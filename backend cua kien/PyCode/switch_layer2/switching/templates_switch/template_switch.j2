{% if action == 'delete' %}
! ==========================================
! CHẾ ĐỘ XÓA CẤU HÌNH (ROLLBACK/DELETE)
! ==========================================

! 1. XÓA CỔNG TRƯỚC (Reset về mặc định)
{% for item in interfaces %}
default interface {{ item.name }}
{% endfor %}

! 2. XÓA VLAN SAU (Tránh lỗi cổng đang dùng VLAN mà xóa VLAN)
{% if danh_sach_vlan is defined %}
{% for v in danh_sach_vlan %}
no vlan {{ v.id }}
{% endfor %}
{% endif %}

{% else %}
! ==========================================
! CHẾ ĐỘ THÊM CẤU HÌNH (CONFIGURE)
! ==========================================

! --- PHẦN 1: TẠO VLAN ---
{% if danh_sach_vlan is defined %}
{% for v in danh_sach_vlan %}
vlan {{ v.id }}
 name {{ v.name }}
 exit
{% endfor %}
{% endif %}

! --- PHẦN 2: CẤU HÌNH CỔNG ---
{% for item in interfaces %}
interface {{ item.name }}
 description {{ item.description }}
 
 ! Logic phân loại Access/Trunk
 {% if item.mode == 'access' %}
  switchport mode access
  switchport access vlan {{ item.vlan_id }}
  
 {% elif item.mode == 'trunk' %}
  ! Switch ảo IOL cần lệnh này trước khi mode trunk
  switchport trunk encapsulation dot1q 
  switchport mode trunk
  
 {% endif %}

 no shutdown
 exit
!
{% endfor %}

{% endif %}