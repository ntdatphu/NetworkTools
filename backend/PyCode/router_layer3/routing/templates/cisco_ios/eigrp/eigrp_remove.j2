! 1. Xóa rác EIGRP trên các Interface trước
{% if config.interfaces %}
 {% for intf in config.interfaces %}
interface {{ intf.name }}
  {% if intf.summary_address %}
 no ip summary-address eigrp {{ config.local_as }} {{ intf.summary_address.ip }} {{ intf.summary_address.mask }}
  {% endif %}
  {% if intf.auth_key_chain %}
 no ip authentication mode eigrp {{ config.local_as }} md5
 no ip authentication key-chain eigrp {{ config.local_as }} {{ intf.auth_key_chain }}
  {% endif %}
  {% if intf.hello_interval %}
 no ip hello-interval eigrp {{ config.local_as }}
  {% endif %}
  {% if intf.delay %}
 no delay
  {% endif %}
 {% endfor %}
{% endif %}

! 2. Nhổ cỏ tận gốc tiến trình EIGRP
no router eigrp {{ config.local_as }}