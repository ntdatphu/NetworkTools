-- MỤC TIÊU: NAT PORT 80 CỦA WEB SERVER RA PORT 8080 CỦA ROUTER
-- ==============================================================

-- 1. BẢNG MẸ: NAT_DB (Lưu thông tin chung của cụm cấu hình)
-- Các thông số dùng: host (IP Router), action_Cfg (Trạng thái kích hoạt)
INSERT INTO NAT_DB (
    nat_id, nat_name, nat_type, host, description, success, action_Cfg
) VALUES (
    1,                       -- nat_id: Khóa chính
    'STATIC_WEB_SERVER',     -- nat_name: Tên gợi nhớ
    'static',                -- nat_type: Loại NAT
    '192.168.121.101',       -- host: IP của Router mục tiêu
    'NAT cho Web nội bộ port 80', -- description
    0,                       -- success: 0 (Chờ đẩy), 1 (Xong), -1 (Xóa)
    1                        -- action_Cfg: 1 (Bật), 0 (Tạm tắt)
);

-- 2. BẢNG CON: nat_interfaces (Khai báo các cổng tham gia NAT)
-- Các thông số dùng: interface_name (Cổng vật lý), nat_role (Vị trí)
INSERT INTO nat_interfaces (
    nat_id, interface_name, nat_role, success
) VALUES 
    (1, 'GigabitEthernet0/1', 'outside', 0), -- Cổng ra Internet
    (1, 'GigabitEthernet0/2', 'inside', 0);  -- Cổng vào mạng nội bộ

-- 3. BẢNG CON: nat_static_mappings (Chi tiết luật NAT tĩnh)
-- Các thông số dùng: IP nguồn/đích, Protocol, Port và cờ extendable
INSERT INTO nat_static_mappings (
    nat_id, inside_local_ip, inside_global_ip, protocol, 
    local_port, global_port, is_extendable, description, success
) VALUES (
    1,              -- nat_id liên kết với NAT_DB
    '10.1.10.100',  -- inside_local_ip: IP Server trong LAN
    '8.8.8.100',    -- inside_global_ip: IP Public đại diện
    'tcp',          -- protocol: Giao thức (tcp/udp)
    80,             -- local_port: Port gốc trên Server
    8080,           -- global_port: Port nhìn từ ngoài Internet
    1,              -- is_extendable: 1 (Bật), 0 (Tắt)
    'Mapping port 80 ra 8080', 
    0               -- success
);