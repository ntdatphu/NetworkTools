    'gt 1024'        -- src_port: Cổng nguồn phải > 1024 (Client thường dùng port cao)
    '10.0.0.0',      -- destination: Dải IP của hệ thống nhận
    '0.255.255.255', -- dest_wildcard: Mặt nạ ngược của hệ thống nhận (/8)
    'eq 80',         -- dest_port: Cổng đích bắt buộc là 80 (Dịch vụ Web)
