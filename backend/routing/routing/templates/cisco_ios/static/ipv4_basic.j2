{# ========================================================== #}
{# 1. XỬ LÝ DEFAULT ROUTES (0.0.0.0 0.0.0.0)                  #}
{# ========================================================== #}
{% if config.default_routes %}
 {% for route in config.default_routes %}
  {% set prefix = 'no ' if route.state == 'remove' or route.action == 'remove' else '' %}
{{ prefix }}ip route 0.0.0.0 0.0.0.0 {{ route.next_hop }}
 {% endfor %}
{% endif %}

{# ========================================================== #}
{# 2. XỬ LÝ STATIC ROUTES BÌNH THƯỜNG                         #}
{# ========================================================== #}
{% if config.static_routes %}
 {% for route in config.static_routes %}
  {# Hỗ trợ cả 2 chuẩn biến: state (DB mới) và action (JSON cũ) #}
  {% set prefix = 'no ' if route.state == 'remove' or route.action == 'remove' else '' %}
  
  {# Logic chọn Next-hop hoặc Interface (Mục 1, 4, 6) #}
  {% set target = '' %}
  {% if route.interface and route.next_hop %}
    {% set target = route.interface ~ ' ' ~ route.next_hop %}
  {% elif route.interface %}
    {% set target = route.interface %}
  {% else %}
    {% set target = route.next_hop %}
  {% endif %}

  {# Tự động map subnet_mask/mask và ad/distance #}
{{ prefix }}ip route {{ route.network }} {{ route.subnet_mask | default(route.mask) }} {{ target }}{% if route.ad %} {{ route.ad }}{% elif route.distance %} {{ route.distance }}{% endif %}{% if route.tag %} tag {{ route.tag }}{% endif %}{% if route.track_id %} track {{ route.track_id }}{% endif %}
 {% endfor %}
{% endif %}